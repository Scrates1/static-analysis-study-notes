        "mode": "javascript",
        "code": "class LocCalCheckerStrategy extends OutputStrategy {\n      //需要定义一个outputStrategyId，在this.resultManager.finding中传入。\n    static outputStrategyId = 'LocCalCheckerStrategy' \n  \n    constructor() {\n      super()\n      this.outputFilePath = 'xxx.json'//若要在文件中输出，这里可以定义\n    }\n \n    outputFindings(resultManager, outputFilePath, config, printf){\n      const allFindings = resultManager.getFindings()\n      const finding = allFindings[LocCalCheckerStrategy.outputStrategyId]\n      //这里喜欢的话可以获取其他的outputStrategyId组合到一个报告里\n      finding.forEach(info => {\n        console.log(`filename:${info.filename}, file content length:${info.length}`)\n      }\n      //使用outputFilePath也可以将它输出到文件\n      //...\n    }\n}",
