      "value": "data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22typescript%22%2C%22code%22%3A%22extractParamNames(route%3A%20string)%3A%20string%5B%5D%20%7B%5Cn%20%20%2F%2F%20%E5%8C%B9%E9%85%8D%20%3Ctype%3Aparam%3E%20%E6%88%96%20%3Cparam%3E%20%E6%A0%BC%E5%BC%8F%5Cn%20%20%2F%2F%20%E4%BE%8B%E5%A6%82%EF%BC%9A'user%2F%3Cint%3Aid%3E'%20%E5%8C%B9%E9%85%8D%E5%88%B0%20'id'%5Cn%20%20%2F%2F%20%20%20%20%20%20'article%2F%3Cslug%3Aslug%3E'%20%E5%8C%B9%E9%85%8D%E5%88%B0%20'slug'%5Cn%20%20const%20regex%20%3D%20%2F%3C(%3F%3A(%3F%3A%5C%5Cw%2B)%3A)%3F(%5C%5Cw%2B)%3E%2Fg%5Cn%20%20const%20params%3A%20string%5B%5D%20%3D%20%5B%5D%5Cn%20%20let%20match%3A%20RegExpExecArray%20%7C%20null%5Cn%20%20while%20((match%20%3D%20regex.exec(route))%20!%3D%3D%20null)%20%7B%5Cn%20%20%20%20params.push(match%5B1%5D)%20%20%2F%2F%20%E6%8F%90%E5%8F%96%E5%8F%82%E6%95%B0%E5%90%8D%5Cn%20%20%7D%5Cn%20%20return%20params%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22id%22%3A%22ja4XE%22%7D",
      "decoded_value": {
        "search": "",
        "mode": "typescript",
        "code": "extractParamNames(route: string): string[] {\n  // 匹配 <type:param> 或 <param> 格式\n  // 例如：'user/<int:id>' 匹配到 'id'\n  //      'article/<slug:slug>' 匹配到 'slug'\n  const regex = /<(?:(?:\\w+):)?(\\w+)>/g\n  const params: string[] = []\n  let match: RegExpExecArray | null\n  while ((match = regex.exec(route)) !== null) {\n    params.push(match[1])  // 提取参数名\n  }\n  return params\n}",
