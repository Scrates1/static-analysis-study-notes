0%20path%3A%20param.id.name%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20kind%3A%20'PYTHON_INPUT'%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20scopeFile%3A%20extractRelativePath(param%3F.loc%3F.sourcefile%2C%20Config.maindir)%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20scopeFunc%3A%20ep.fdef%3F.id%3F.name%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20locStart%3A%20param.loc.start.line%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20locEnd%3A%20param.loc.end.line%2C%5Cn%20%20%20%20%20%20%20%20%20%20%7D)%5Cn%20%20%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%7D%5Cn%20%20%20%20%20%20%2F%2F%20%E5%88%9B%E5%BB%BAEntryPoint%5Cn%20%20%20%20%20%20analyzer.entryPoints.push(completeEntryPoint(ep))%5Cn%20%20%20%20%7D%5Cn%20%20%7D%20else%20%7B%5Cn%20%20%20%20%2F%2F%20%E6%B2%A1%E6%9C%89URL%E5%8F%82%E6%95%B0%EF%BC%8C%E7%9B%B4%E6%8E%A5%E5%88%9B%E5%BB%BAEntryPoint%5Cn%20%20%20%20for%20(const%20ep%20of%20entrypoints%20as%20any%5B%5D)%20%7B%5Cn%20%20%20%20%20%20analyzer.entryPoints.push(completeEntryPoint(ep))%5Cn%20%20%20%20%7D%5Cn%20%20%7D%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22id%22%3A%22jNCsO%22%7D",
